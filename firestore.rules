rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User private data tree and subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Allow public profile read for friends/leaderboard if profileVisibility is public
      match /profile/{docId} {
        allow read: if isOwner(userId) || (isAuthenticated() && resource.data.profileVisibility == 'public');
        allow write: if isOwner(userId);
      }

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Health check / connection test document
    match /test/connection {
      allow read: if true;
    }

    // Authoritative ranked profiles (read-only for owner, client writes disabled to ensure secure backend-only RP updates)
    match /rankedProfiles/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Authoritative ranked matches audit records (read-only for match owner, client writes strictly prohibited)
    match /rankedMatches/{matchId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Authoritative ranked question bank (server-side only, client reads and writes strictly prohibited)
    match /rankedQuestionBank/{questionId} {
      allow read, write: if false;
    }

    // Minimal opt-in public learning stats for Friends Leaderboard (Milestone 4.3A)
    match /publicLearningStats/{userId} {
      // Only authenticated users can read participating public summaries
      allow read: if isAuthenticated();

      // A signed-in user can delete only their own public summary
      allow delete: if isOwner(userId);

      // A signed-in user can create or update only their own public summary with strict validation
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'avatar', 'totalXp', 'streakDays', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 40
        && (request.resource.data.get('avatar', '') is string && request.resource.data.get('avatar', '').size() <= 1000)
        && request.resource.data.totalXp is int
        && request.resource.data.totalXp >= 0
        && request.resource.data.streakDays is int
        && request.resource.data.streakDays >= 0
        && (request.resource.data.updatedAt is int || request.resource.data.updatedAt is timestamp)
        && (request.resource.data.updatedAt is int ? request.resource.data.updatedAt > 0 : true);
    }

    // Default deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
